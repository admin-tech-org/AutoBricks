version:1
data/YYYYMMDD-HHMMSS-agent_product-task_name/
├── tmp/                              # 分析、草稿與其他中間檔案
└── output/
    ├── output_schema_version         # 交付結構的版本與說明
    ├── template.json                 # Bricks 模板與頁面設定
    ├── code-snippets.json            # PHP 片段匯入檔，無片段時清單為空
    ├── assets/<asset-folder>/        # 圖片、影片、字型等非程式碼素材
    ├── snippets/                     # PHP 包裝與 CSS／JS 副本，可為空
    ├── replace-domain.py             # 更換部署網址
    ├── rename-assets-folder.py       # 更換素材資料夾名稱
    ├── report.md                     # 匯入教學、維護位置與驗收結果
    ├── comparison.html               # 原站與成品的驗收對照
    ├── screenshots/                  # 比較頁使用的截圖及必要動態證據
    └── YYYYMMDD-HHMMSS-<page-name>-bricks.zip  # 包含 output 檔案，不含 ZIP 自身
