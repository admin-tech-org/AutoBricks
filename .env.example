# Bricks CDP Visual Generator — environment configuration
# Copy this file to `.env` and adjust as needed. ALL variables are optional;
# the app runs with the defaults below out of the box. No secrets are required.

# API server port (apps/api)
PORT=4000

# Number of jobs the in-memory queue processes concurrently
WORKER_CONCURRENCY=2

# Override where generated artifacts are written (default: ./storage)
# STORAGE_DIR=./storage
